{
  "name": "sondar-proyect",
  "version": "1.0.0",
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "scripts": {
    "local:start": "node scripts/local-supabase.cjs start",
    "local:stop": "node scripts/local-supabase.cjs stop",
    "local:status": "node scripts/local-supabase.cjs status",
    "db:migrate": "supabase migration up --local",
    "db:history": "supabase migration list --local",
    "start:all": "npm run docker:up",
    "start_server": "npm run start_server --prefix Backend",
    "install_all": "npm install -i && cd Backend && npm install -i && cd ../Frontend && npm install -i",
    "start_front": "npm run dev --prefix Frontend",
    "start_mobile": "npm run docker:up",
    "dev:mobile": "npm run docker:up",
    "son": "npm run docker:up:clear",
    "sepalabola": "npm run docker:up:clear",
    "dev:mobile:clear": "npm run docker:up:clear",
    "dev:mobile:lan": "npm run docker:up",
    "dev:mobile:lan:clear": "npm run docker:up:clear",
    "dev:mobile:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-mobile.ps1 -Tunnel",
    "dev:mobile:tunnel:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-mobile.ps1 -Tunnel -Clear",
    "setup:mobile:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/allow-sondar-lan.ps1",
    "dev": "npm run docker:up",
    "dev:host": "concurrently --kill-others-on-fail \"npm run start_server\" \"npm run dev --prefix Frontend -- --host localhost --port 3001 --strictPort\"",
    "dev:all:lan": "npm run docker:up",
    "build": "vite build && npm run build --prefix Frontend",
    "docker:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-docker.ps1 -Action up",
    "docker:up:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-docker.ps1 -Action up -Clear",
    "docker:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-docker.ps1 -Action down",
    "docker:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-docker.ps1 -Action status",
    "docker:logs": "docker compose logs --follow --tail=100 api web mobile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~58.0.19",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "supabase": "2.119.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
