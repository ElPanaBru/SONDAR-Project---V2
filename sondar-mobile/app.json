{
  "expo": {
    "name": "SONDAR",
    "slug": "sondar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sondar",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sondar.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SONDAR usa tu ubicación para mostrar y crear eventos cerca tuyo.",
        "NSPhotoLibraryUsageDescription": "SONDAR accede a tus fotos para elegir portadas y tu avatar."
      }
    },
    "android": {
      "package": "app.sondar.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SONDAR accede a tus fotos para elegir portadas y tu avatar.",
          "cameraPermission": "SONDAR puede usar la cámara para crear imágenes de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SONDAR usa tu ubicación para mostrar y crear eventos cerca tuyo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
