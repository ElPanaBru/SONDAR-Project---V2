# El arranque local genera Backend/.env.local con las claves de la CLI.
# Este archivo sirve como referencia; no requiere credenciales de la nube.
PORT=3000
FRONTEND_URL=http://localhost:8081
DB_HOST=127.0.0.1
DB_PORT=55322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVENTOS_BUCKET=eventos
SUPABASE_PERFILES_BUCKET=perfiles
SUPABASE_REELS_BUCKET=reels
AUTO_MIGRATE_SETTINGS=false
